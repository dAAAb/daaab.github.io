  </link>
  <joint name="fl_hip_yaw" type="revolute">
    <parent link="body"/><child link="fl_hip"/>
    <origin xyz="0.04625 0 -0.0385" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-1.6" upper="1.6" effort="6" velocity="8"/>
  </joint>
  <joint name="fl_hip_pitch" type="revolute">
