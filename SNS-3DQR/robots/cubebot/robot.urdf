<?xml version="1.0"?>
<robot name="cubebot">
  <material name="shell"><color rgba="0.98 0.72 0.12 1"/></material>
  <material name="joint"><color rgba="0.12 0.12 0.12 1"/></material>
  <material name="foot"><color rgba="0.16 0.16 0.16 1"/></material>
  <link name="body">
    <visual><origin xyz="0 0 0"/><geometry><box size="0.0925 0.055 0.077"/></geometry><material name="shell"/></visual>
  </link>
  <link name="fl_hip">
    <visual><origin xyz="0 0 0"/><geometry><cylinder radius="0.012" length="0.022"/></geometry><material name="joint"/></visual>
  </link>
  <link name="fl_thigh">
    <visual><origin xyz="0 -0.024 0"/><geometry><box size="0.016 0.048 0.016"/></geometry><material name="shell"/></visual>
  </link>
